# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# AI 工具本地目录（Claude Code / ZCode 的本地设置与会话记录，不进 git）
.claude/
.zcode/

# Environment files (forbidden in this project)
.env
.env.*
!.env.example
dotenv*

# Cobalt API cookies (contains Instagram session secrets)
/cookies.json

# 登录 cookie（含账号凭据，绝不入库）。默认位置见 qqmusic_parser 的 cookiefile 配置。
BotData/cookies/*
!BotData/cookies/.gitkeep

# Config files with secrets (templates in *.example.json)
BotData/config.json
BotData/hikari_ai_config.json
BotData/plugin_configs/*.json
!BotData/plugin_configs/*.example.json
BotData/resources/*.json
!BotData/resources/*.example.json
BotData/fonts/*
!BotData/fonts/.gitkeep
BotData/agent_personas/*
!BotData/agent_personas/.gitkeep

# Gifs: keep directory structure, ignore actual media
BotData/Gifs/*/**
!BotData/Gifs/**/.gitkeep

# Voices: keep directory structure, ignore actual media
BotData/Voices/*/**
!BotData/Voices/**/.gitkeep

# Logs (history logs on dev machine)
BotData/logs/*.log
!BotData/logs/.gitkeep

# User data (sensitive)
UserData/private/*.jsonl
UserData/group/*.jsonl
UserData/stats/
UserData/rss_subscriber_state.json
UserData/sts2_wiki_cache.json
UserData/sts2_wiki_cache.json.*.tmp
# 临时媒体清理进度（运行时状态，各部署各自维护）
UserData/temp_media_cleanup.json
!UserData/.gitkeep

# Local deployment legal documents
USER_AGREEMENT.local.md
PRIVACY_POLICY.local.md

# System
.DS_Store
Thumbs.db

# MyPy / PyTest
.mypy_cache/
.pytest_cache/
.python-version

# Temporary media
/tmp/hikari_bot/
/runtime/
deploy-source-files-*.txt
version.json

# Docker runtime data
astrbot/
napcat/

# ... but track the astrbot shim used by the compat layer
!plugins/astrbot_compat/shim/astrbot/
sharedFolder/
!sharedFolder/
!sharedFolder/.gitkeep
tmp/
legacy/
