{
  "qqbot": {
    "appid": "YOUR_APPID",
    "secret": "YOUR_APPSECRET",
    "sandbox": true,
    "intents": ["GROUP_AND_C2C_EVENT"],
    "logLevel": "info",
    "removeAt": true,
    "maxRetry": 10,
